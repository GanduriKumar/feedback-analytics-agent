# Backend Environment Variables
# Only LLM provider credentials go here - internal API keys are in code

# Reddit API Credentials (get from https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=Review scrapper 1.0
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
TIME_FILTER=all

# LLM Provider Configuration (OpenAI or compatible API)
BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=your_openai_api_key_here
INFERENCE_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-large

REVIEW_COLLECTION_NAME=reviews